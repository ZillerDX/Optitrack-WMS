{
  "name": "optitrack-wms-desktop",
  "version": "1.0.0",
  "description": "Production-Ready Desktop Warehouse Management System",
  "main": "main.js",
  "author": "ZillerDX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.optitrack.wms",
    "productName": "OptiTrack WMS",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "../frontend/.next/standalone",
        "to": "standalone",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}