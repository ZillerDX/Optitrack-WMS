# OptiTrack WMS environment. Copy to .env.local (development) or set these in your host.
# UI and API are one Next.js app, so there is no separate API URL to configure.

# ---- Required: API requests fail (500) without these three --------------------------
# >= 32 random characters, e.g. `openssl rand -hex 32`. Signs session and reset tokens.
SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-side only. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google sign-in (optional; the button answers 503 until it is set) --------------
# Must be the client id the browser signs in with; tokens for any other audience are rejected.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# ---- Password reset emails ---------------------------------------------------------
# APP_URL is the public site URL used to build the emailed link. It is deliberately NOT
# derived from request headers.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: From address (defaults to SMTP_USER)
SMTP_FROM=

# ---- AI assistant (optional; a built-in analytics fallback answers without keys) -----
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- Sign-up policy ------------------------------------------------------------------
# Restrict who can create an account (password sign-up and Google) to these email domains,
# comma separated. Empty = open sign-up. Existing users are unaffected.
SIGNUP_ALLOWED_DOMAINS=

# ---- Database ------------------------------------------------------------------------
# Apply supabase/migrations/*.sql to the project, in order (0000 ... 0007), before the first
# deploy and before deploying a version that needs a newer one. Rate limiting uses
# 0007_rate_limits.sql; if it is missing the limiter fails open and logs an error.
