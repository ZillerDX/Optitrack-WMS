# OptiTrack WMS Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match the client id the browser signs in with; tokens for any other audience are rejected
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server-side only (REQUIRED - the app refuses to start requests without them)
# SECRET_KEY: >= 32 random chars, e.g. `openssl rand -hex 32`
SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Never expose the service-role key to the browser or commit it
SUPABASE_SERVICE_ROLE_KEY=
