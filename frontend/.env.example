# OptiTrack WMS Frontend Environment
NEXT_PUBLIC_API_URL=http://localhost:8000
# Must match the client id the browser signs in with; tokens for any other audience are rejected
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server-side only (REQUIRED - the app refuses to start requests without them)
# SECRET_KEY: >= 32 random chars, e.g. `openssl rand -hex 32`
SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Never expose the service-role key to the browser or commit it
SUPABASE_SERVICE_ROLE_KEY=

# Password reset emails (Next.js API). APP_URL is the public site URL used to build the
# emailed link; it is deliberately NOT derived from request headers.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional: From address (defaults to SMTP_USER)
SMTP_FROM=

# Rate limiting for the Next.js API uses the Supabase table/function from
# backend/supabase/migrations/rate_limits.sql (run it once). If it is missing the
# limiter fails open and logs an error.

# Optional: restrict who can create an account (password sign-up and Google) to these
# email domains, comma separated. Empty = open sign-up. Existing users are unaffected.
SIGNUP_ALLOWED_DOMAINS=
